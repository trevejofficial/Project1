{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "server/dist",
    "rootDir": "server",
    "sourceMap": true
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules", "server/dist", "server/**/*.test.ts"]
}
